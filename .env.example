# Edge8 web: environment variables
#
# This file is new and intentionally partial: it documents the variables the
# documents feature reads. Other features in this repo predate it. Add the
# variables you rely on as you touch each area, so this file becomes complete
# by attrition rather than by one unverified sweep.
#
# Never put real values here. Real values live in Vercel and in .env.local,
# which is gitignored.

# Supabase, server side. Already configured in Vercel.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Supabase, browser side. Already configured in Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Shared secret for POST /api/docs/publish, used by scripts/docs/publish.mjs.
# Set the same value in Vercel and in the publishing machine's environment
# (or ~/.claude/.env). Without it, the publish endpoint returns 503 and
# reading documents is unaffected.
DOCS_PUBLISH_TOKEN=

# Resend delivery webhooks -> company_os.email_events, read by the Marketing
# page's Deliverability card. Copy the signing secret (whsec_...) shown when you
# add the endpoint in the Resend dashboard. The endpoint MUST be registered as
# https://www.edge8.ai/api/webhooks/resend/ with the trailing slash: the app sets
# trailingSlash: true, and Resend does not follow the 308 the slashless URL
# returns. Without this var the route returns 503 and ingests nothing, so a
# half-configured deploy fails loudly instead of accepting unverified payloads.
RESEND_WEBHOOK_SECRET=

# Signing key for unsubscribe links. Any long random string; rotate it and every
# previously mailed unsubscribe link stops working, so treat it as permanent.
# Without it, marketing email sends with no unsubscribe link and no
# List-Unsubscribe header, which is both bad practice and a spam-folder risk.
UNSUBSCRIBE_SECRET=

# Absolute origin used to build unsubscribe links. Defaults to
# https://www.edge8.ai when unset.
NEXT_PUBLIC_SITE_URL=

# Sender identity for MARKETING email only. Transactional email keeps using
# EMAIL_FROM. Defaults to "Edge8 <hello@edge8.ai>". The address must be verified
# in Resend or DKIM will not align.
MARKETING_EMAIL_FROM=

# Physical postal address printed in the footer of every marketing email.
# CAN-SPAM requires one on commercial email.
MARKETING_POSTAL_ADDRESS=
