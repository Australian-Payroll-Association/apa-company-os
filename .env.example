# Edge8 web: environment variables
#
# This file is new and intentionally partial: it documents the variables the
# documents feature reads. Other features in this repo predate it. Add the
# variables you rely on as you touch each area, so this file becomes complete
# by attrition rather than by one unverified sweep.
#
# Never put real values here. Real values live in Vercel and in .env.local,
# which is gitignored.

# Supabase, server side. Already configured in Vercel.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Supabase, browser side. Already configured in Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Shared secret for POST /api/docs/publish, used by scripts/docs/publish.mjs.
# Set the same value in Vercel and in the publishing machine's environment
# (or ~/.claude/.env). Without it, the publish endpoint returns 503 and
# reading documents is unaffected.
DOCS_PUBLISH_TOKEN=
