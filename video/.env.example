# Copy to video/.env and fill in. Never commit the filled file.

# Where the rig records from. Point at the demo tenant once it exists.
E8_BASE_URL=http://localhost:3000

# Demo admin account, scoped to the demo tenant. Password sign-in, not magic link:
# the rig cannot read email. See README, "Demo login".
E8_DEMO_EMAIL=
E8_DEMO_PASSWORD=

# ElevenLabs. Voice is resolved by name against your account library, so the
# pick survives an id change. E8_VOICE_ID overrides the name if set.
ELEVENLABS_API_KEY=
E8_VOICE_NAME=Brian
# E8_VOICE_ID=
E8_VOICE_MODEL=eleven_multilingual_v2
E8_VOICE_SPEED=1.0

# Browser zoom for the capture. 1.4 is the brand-kit recommendation: a dashboard
# at native zoom is unreadable at 380px wide in a muted LinkedIn autoplay.
E8_ZOOM=1.4

# Set to 1 to re-run the login even if a cached session exists.
# E8_FORCE_LOGIN=1
